# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin / Java / Kotlin DSL / XML
[*.{kt,kts,java,xml}]
indent_style = space
indent_size = 4

# Build & CI & docs
[*.{yml,yaml,json}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Windows batch files must keep CRLF
[*.{bat,cmd}]
end_of_line = crlf
