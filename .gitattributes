# Normalize text files to LF in the repository and the working tree.
* text=auto eol=lf

# Windows scripts need CRLF to run with cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper script must stay executable / LF on every platform.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files: never convert or diff as text.
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.webp binary
